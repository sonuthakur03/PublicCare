// CivicPulse - Lalitpur Municipality Prisma Schema
// Compatible with standard Postgres VARCHAR columns

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String        @map("password_hash")
  role               String        @default("user")
  organizationName   String?       @map("organization_name")
  registrationNumber String?       @map("registration_number")
  createdAt          DateTime      @default(now()) @map("created_at")
  
  issues             Issue[]
  votes              IssueVote[]
  ngoKeys            NgoApiKey[]
  chatMessages       ChatMessage[]
  vendor             Vendor?

  @@map("users")
}

model Issue {
  id              String      @id @default(cuid())
  userId          String?     @map("user_id")
  title           String
  category        String
  description     String      @db.Text
  locationLat     Float       @map("location_lat")
  locationLng     Float       @map("location_lng")
  address         String
  imageUrl        String?     @map("image_url")
  status          String      @default("REPORTED")
  netUpvotes      Int         @default(0) @map("net_upvotes")
  createdAt       DateTime    @default(now()) @map("created_at")
  escalatedAt     DateTime?   @map("escalated_at")
  resolvedAt      DateTime?   @map("resolved_at")
  resolutionNotes String?     @db.Text @map("resolution_notes")
  reporterName    String?     @map("reporter_name")
  reporterContact String?     @map("reporter_contact")

  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  votes           IssueVote[]
  tenders         Tender[]

  @@index([status])
  @@index([netUpvotes])
  @@index([createdAt])
  @@map("issues")
}

model IssueVote {
  id        String   @id @default(cuid())
  issueId   String   @map("issue_id")
  userId    String   @map("user_id")
  voteType  String   @default("UP") @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")

  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issueId, userId])
  @@map("issue_votes")
}

model NgoApiKey {
  id                  String   @id @default(cuid())
  userId              String   @map("user_id")
  orgName             String   @map("org_name")
  apiKey              String   @unique @map("api_key")
  tier                String   @default("COMMUNITY")
  rateLimit           Int      @default(5000) @map("rate_limit")
  subscriptionCostNpr Float    @default(0.0) @map("subscription_cost_npr")
  requestCount        Int      @default(0) @map("request_count")
  createdAt           DateTime @default(now()) @map("created_at")

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ngo_api_keys")
}

model ChatMessage {
  id          String   @id @default(cuid())
  userId      String?  @map("user_id")
  senderName  String   @map("sender_name")
  isAnonymous Boolean  @default(true) @map("is_anonymous")
  text        String   @db.Text
  roomKey     String   @map("room_key")
  ipSubnet    String   @map("ip_subnet")
  locationLat Float?   @map("location_lat")
  locationLng Float?   @map("location_lng")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([roomKey])
  @@index([createdAt])
  @@map("chat_messages")
}

// ─── Vendor System ────────────────────────────────────────

model Vendor {
  id            String   @id @default(cuid())
  userId        String   @unique @map("user_id")
  companyName   String   @map("company_name")
  businessType  String   @map("business_type")
  description   String   @db.Text
  contactPhone  String?  @map("contact_phone")
  website       String?
  logoUrl       String?  @map("logo_url")
  locationLat   Float    @map("location_lat")
  locationLng   Float    @map("location_lng")
  address       String
  serviceRadius Float    @default(5.0) @map("service_radius")
  isApproved    Boolean  @default(false) @map("is_approved")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ads           Ad[]
  tenders       Tender[]

  @@index([businessType])
  @@index([isApproved])
  @@map("vendors")
}

model Ad {
  id          String   @id @default(cuid())
  vendorId    String   @map("vendor_id")
  title       String
  description String   @db.Text
  imageUrl    String?  @map("image_url")
  linkUrl     String?  @map("link_url")
  placement   String   @default("FEED")
  isActive    Boolean  @default(true) @map("is_active")
  isApproved  Boolean  @default(false) @map("is_approved")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  startDate   DateTime @default(now()) @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime @default(now()) @map("created_at")

  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([placement])
  @@index([isActive])
  @@index([isApproved])
  @@map("ads")
}

model Tender {
  id               String    @id @default(cuid())
  vendorId         String    @map("vendor_id")
  issueId          String    @map("issue_id")
  proposalText     String    @db.Text @map("proposal_text")
  estimatedCostNpr Float     @map("estimated_cost_npr")
  estimatedDays    Int       @map("estimated_days")
  status           String    @default("SUBMITTED")
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  respondedAt      DateTime? @map("responded_at")
  responseNotes    String?   @db.Text @map("response_notes")

  vendor           Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  issue            Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([issueId])
  @@index([vendorId])
  @@map("tenders")
}
